# Copy to apps/api/.env (read by `node --env-file-if-exists=.env`). Every variable is optional.

# API server
PORT=4300
HOST=127.0.0.1
# Behind reverse proxies (Cloudflare Tunnel, nginx…): how many of them to trust. The client address
# (per-visitor rate limits) is then the X-Forwarded-For entry they added; unset, the header is ignored.
# TRUST_PROXY=1
# Where the databases live: system.db (accounts, sessions) and accounts/<id>.db (one per account)
# SPENDLENS_DATA_DIR=./data
# Login and name of the owner account created when an older single-database install is moved over
# SPENDLENS_OWNER_EMAIL=you@example.com
# SPENDLENS_OWNER_NAME=Personale

# AI keys used when none is saved in Settings → AI provider
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENAI_COMPATIBLE_API_KEY=

# ECB exchange rates (Frankfurter); override for a self-hosted instance
# SPENDLENS_FX_API=https://api.frankfurter.dev/v1
