{
  "name": "@spendlens/api",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "Spendlens API: Hono on Node 26, node:sqlite storage, AI extraction through a provider seam.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "seed": "node --env-file-if-exists=.env src/scripts/seed.ts",
    "account": "node --env-file-if-exists=.env src/scripts/account.ts",
    "build:browser": "node src/scripts/build-browser.ts",
    "demo:snapshot": "node --env-file-if-exists=.env src/scripts/demo-snapshot.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@spendlens/contracts": "*",
    "hono": "^4.13.16",
    "openai": "^7.51.0",
    "unpdf": "^2.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "esbuild": "^0.28.2",
    "pdf-lib": "^1.17.1"
  }
}
